# ── Required in production ───────────────────────────────────────────────
# Postgres connection string. On Vercel: Storage -> Neon -> connect (sets this for you).
# Leave unset locally to use the embedded database in .data/
DATABASE_URL=
# The one password that opens the dashboard.
CELO_PASSWORD=
# 32+ random characters. Signs your login session and encrypts keys saved on the Integrations page.
# Generate: openssl rand -base64 32      (changing it later logs you out and clears saved keys)
CELO_SECRET=
# Random string. Vercel Cron sends it automatically; an external pinger sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────
# Your timezone for "today" and month boundaries (IANA name).
CELO_TIMEZONE=America/New_York
# Shown in the greeting: "Good morning, <name>."
CELO_OWNER_NAME=
# Public URL, only needed if Google OAuth must use a fixed redirect (custom domain).
CELO_PUBLIC_URL=

# Any integration key can live here instead of on the Integrations page.
# An env var always wins over a saved key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_ACCESS_TOKEN=
# API versions (defaults: Google Ads v26, Meta Graph v26.0)
GOOGLE_ADS_API_VERSION=
META_API_VERSION=
